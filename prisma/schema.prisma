generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//
// ============================================================
// ENUMS
// ============================================================
//

enum UserRole {
  student
  admin
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DictationCategory {
  GENERAL
  PROFESSIONAL
  LEGAL
}

enum DictationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssignmentTargetType {
  STUDENT
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
}

// Mirrors the scoring engine exactly: a token is wrong
// (substituted), missed (deleted), or extra (inserted).
enum EvaluationErrorType {
  MISSING
  EXTRA
  SUBSTITUTION
}

enum ScheduleStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TypingTestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

//
// ============================================================
// BETTER AUTH USER
// ============================================================
// Better Auth owns the authentication lifecycle. `role` is kept
// here because authorization is application-level. `banned` /
// `banReason` power the admin lockout (Better Auth admin plugin).
// Table is mapped to "user" to match Better Auth's expectations.
//

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(student)

  // Admin lockout (Better Auth admin plugin).
  banned     Boolean  @default(false)
  banReason  String?
  banExpires DateTime? @db.Timestamptz(3)

  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  studentProfile StudentProfile?

  createdDictations Dictation[] @relation("DictationCreatedBy")





  sessions     Session[]
  accounts     Account[]
  loginAttempts LoginAttempt[]

  @@map("user")
}

//
// ============================================================
// LOGIN AUDIT LOG
// ============================================================
// Every sign-in attempt (success or failure) is recorded so the
// admin has full visibility: who, when, from where, and whether
// it worked. Written by the auth hooks in lib/auth.ts.
//

model LoginAttempt {
  id        String  @id @default(uuid())
  email     String
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  success   Boolean
  ipAddress String?
  userAgent String?
  reason    String?

  createdAt DateTime @db.Timestamptz(3) @default(now())

  @@index([email])
  @@index([userId])
  @@index([createdAt])
}

//
// ============================================================
// STUDENTS / BATCHES
// ============================================================
//

model StudentProfile {
  id     String        @id @default(uuid())
  userId String        @unique
  phone  String?
  status StudentStatus @default(ACTIVE)
  notes  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)



  typingAttempts TypingAttempt[]


  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  @@index([status])
}

//
// ============================================================
// DICTATIONS
// ============================================================
// Audio is hosted on YouTube (youtubeId). No R2 object storage.
//

model Dictation {
  id       String            @id @default(uuid())
  title    String
  category DictationCategory
  status   DictationStatus   @default(DRAFT)

  referenceTranscript String

  youtubeId         String?
  durationSeconds   Int?

  createdById String
  createdBy   User   @relation("DictationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  typingAttempts TypingAttempt[]

  createdAt   DateTime @db.Timestamptz(3)  @default(now())
  updatedAt   DateTime @db.Timestamptz(3)  @updatedAt
  publishedAt DateTime? @db.Timestamptz(3)

  @@index([status])
  @@index([category])
  @@index([createdById])
}

//
// ============================================================
// ASSIGNMENTS
// ============================================================
// An assignment targets either:
// STUDENT -> studentId populated
// Application/server validation must enforce that exactly one
// target is supplied.
//


//
// ============================================================
// DICTATION ATTEMPTS
// ============================================================
// A student is reached through their StudentProfile (single link).
//


//
// ============================================================
// EVALUATION
// ============================================================
// Mirrors the scoring engine output: items accuracy (words +
// punctuation), completion, net/raw WPM, and wrong/missed/extra
// counts split by words and punctuation.
//



//
// ============================================================
// TYPING SUITE
// ============================================================
// Only dictation attempts are persisted. Free practice and custom
// text are local-only by product decision, so every stored row must
// point at the dictation it was scored against. `dictationId` stays
// nullable in the database only so this migration is additive; the
// API never writes a row without it.
//

model TypingAttempt {
  id String @id @default(uuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)

  dictationId String?
  dictation   Dictation? @relation(fields: [dictationId], references: [id], onDelete: Restrict)

  typedText String

  elapsedMs Int

  wpm      Float
  accuracy Float
  /** How much of the dictation was covered, 0-100. */
  completion   Int
  wordsCorrect Int
  wordsTotal   Int

  completed Boolean @default(false)

  createdAt DateTime @db.Timestamptz(3) @default(now())

  @@index([studentId, createdAt])
  @@index([dictationId])
}

//
// ============================================================
// FEES
// ============================================================
//

//
// ============================================================
// SCHEDULE
// ============================================================
//


//
// ============================================================
// ANNOUNCEMENTS
// ============================================================
//


//
// ============================================================
// BETTER AUTH TABLES
// ============================================================
// Managed by Better Auth. Do not edit by hand.
//

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime @db.Timestamptz(3)  @default(now())
  updatedAt             DateTime @db.Timestamptz(3)  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @db.Timestamptz(3) @default(now())
  updatedAt  DateTime @db.Timestamptz(3) @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String   @id
  key         String   @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

