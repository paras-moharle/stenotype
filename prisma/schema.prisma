generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//
// ============================================================
// ENUMS
// ============================================================
//

enum UserRole {
  student
  admin
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DictationCategory {
  GENERAL
  PROFESSIONAL
  LEGAL
}

enum DictationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Mirrors the scoring engine exactly: a token is wrong
// (substituted), missed (deleted), or extra (inserted).
//
// ============================================================
// BETTER AUTH USER
// ============================================================
// Better Auth owns the authentication lifecycle. `role` is kept
// here because authorization is application-level. `banned` /
// `banReason` power the admin lockout (Better Auth admin plugin).
// Table is mapped to "user" to match Better Auth's expectations.
//

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(student)

  // Admin lockout (Better Auth admin plugin).
  banned     Boolean  @default(false)
  banReason  String?
  banExpires DateTime? @db.Timestamptz(3)

  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  studentProfile StudentProfile?

  createdDictations Dictation[] @relation("DictationCreatedBy")





  sessions     Session[]
  accounts     Account[]
  loginAttempts LoginAttempt[]

  @@map("user")
}

//
// ============================================================
// LOGIN AUDIT LOG
// ============================================================
// Successful sign-ins are recorded so the admin can see who signed in,
// when, and from where. Failed attempts are not captured yet: Better
// Auth exposes no reliable failure hook, so `success` is currently
// always true. Written by the auth hooks in lib/auth.ts.
//

model LoginAttempt {
  id        String  @id @default(uuid())
  email     String
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  success   Boolean
  ipAddress String?
  userAgent String?
  reason    String?

  createdAt DateTime @db.Timestamptz(3) @default(now())

  @@index([email])
  @@index([userId])
  @@index([createdAt])
}

//
// ============================================================
// STUDENTS / BATCHES
// ============================================================
//

model StudentProfile {
  id     String        @id @default(uuid())
  userId String        @unique
  phone  String?
  status StudentStatus @default(ACTIVE)
  notes  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)



  typingAttempts TypingAttempt[]


  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  @@index([status])
}

//
// ============================================================
// DICTATIONS
// ============================================================
// Audio is hosted on YouTube (youtubeId). No R2 object storage.
//

model Dictation {
  id       String            @id @default(uuid())
  title    String
  category DictationCategory
  status   DictationStatus   @default(DRAFT)

  referenceTranscript String

  youtubeId         String?
  durationSeconds   Int?

  createdById String
  createdBy   User   @relation("DictationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  typingAttempts TypingAttempt[]

  createdAt   DateTime @db.Timestamptz(3)  @default(now())
  updatedAt   DateTime @db.Timestamptz(3)  @updatedAt
  publishedAt DateTime? @db.Timestamptz(3)

  @@index([status])
  @@index([category])
  @@index([createdById])
}

//
// ============================================================
// TYPING SUITE
// ============================================================
// Only dictation attempts are persisted. Free practice and custom
// text are local-only by product decision, so every stored row must
// point at the dictation it was scored against.
//

// Published scoring text is shared by exact content. Application writes
// only insert missing references. Historical attempts without a snapshot
// deliberately keep no reference assignment.
model DictationReference {
  digest     String @id
  transcript String
  attempts   TypingAttempt[]
}

model TypingAttempt {
  id String @id @default(uuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)

  dictationId String
  dictation   Dictation @relation(fields: [dictationId], references: [id], onDelete: Restrict)

  submissionKey     String?
  referenceSnapshot String? // Compatibility for older writers
  referenceDigest   String?
  reference         DictationReference? @relation(fields: [referenceDigest], references: [digest], onDelete: Restrict, onUpdate: Restrict)
  scoreVersion       Int?
  rawWpm            Int?

  typedText String

  elapsedMs Int

  wpm      Float
  accuracy Float

  // Full result breakdown. Every column defaults to 0 so an older
  // deployed build can still insert; the API always writes the real
  // numbers.
  /** How much of the dictation was covered, 0-100. */
  completion Int @default(0)

  wordsCorrect   Int @default(0)
  wordsIncorrect Int @default(0)
  wordsExtra     Int @default(0)
  wordsMissed    Int @default(0)
  wordsTotal     Int @default(0)

  punctuationCorrect   Int @default(0)
  punctuationIncorrect Int @default(0)
  punctuationExtra     Int @default(0)
  punctuationMissed    Int @default(0)
  punctuationTotal     Int @default(0)

  completed Boolean @default(false)

  createdAt DateTime @db.Timestamptz(3) @default(now())

  @@unique([studentId, submissionKey])
  @@index([studentId, createdAt])
  @@index([dictationId])
}

//
// ============================================================
// BETTER AUTH TABLES
// ============================================================
// Managed by Better Auth. Do not edit by hand.
//

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime @db.Timestamptz(3)  @default(now())
  updatedAt             DateTime @db.Timestamptz(3)  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @db.Timestamptz(3) @default(now())
  updatedAt  DateTime @db.Timestamptz(3) @updatedAt

  @@index([identifier])
  @@map("verification")
}


model AbuseBucket {
  key     String   @id
  count   Int
  resetAt DateTime @db.Timestamptz(3)

  @@index([resetAt])
}

// Historical null-dictation records are retained outside the active app.
model LegacyTypingAttemptArchive {
  id  String @id
  row Json
}
