{
  "name": "stenotype",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12 || >=24"
  },
  "packageManager": "pnpm@12.19.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.mjs\"",
    "test:smoke": "tsx --test tests/auth-http.test.mjs",
    "test:ui": "tsx --test tests/typing-ui-browser.test.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:check-sync": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:verify": "node scripts/db/verify.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.1.0",
    "better-auth": "^1.3.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.446.0",
    "next": "16.4.5",
    "pg": "^8.13.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "^4.3.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "prisma": "^7.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
