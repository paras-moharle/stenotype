# Copy to .env.local and fill in real values. Never commit .env.local.
# pnpm dev requires DATABASE_URL, BETTER_AUTH_URL and BETTER_AUTH_SECRET here.

# ── Required ────────────────────────────────────────────────
# pnpm dev accepts only the approved direct verification clone, never production.
DATABASE_URL=postgresql://user:password@your-disposable-endpoint.neon.tech:5432/stenotype?sslmode=verify-full

# Signs session cookies. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-32-byte-random-secret

# Public origin of the app. Must match the port/host you browse,
# otherwise Better Auth rejects sign-in with 403 INVALID_ORIGIN.
BETTER_AUTH_URL=http://localhost:3000

# ── Seed accounts (used by `pnpm db:seed` only) ─────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
STUDENT_EMAIL=student@example.com
STUDENT_PASSWORD=replace-with-a-strong-password

# ── Optional ────────────────────────────────────────────────
# Use 0.0.0.0 only for direct LAN access.
STENO_DEV_PORT=3000
STENO_DEV_BIND=127.0.0.1
# Exact same-scheme origins, comma separated. Use the HTTPS tunnel as the
# canonical BETTER_AUTH_URL when testing through it.
STENO_DEV_TRUSTED_ORIGINS=

# Optional local storage guard. Reported Neon project usage can raise the
# estimate above the PostgreSQL database size. Update after console review.
DB_STORAGE_BUDGET_BYTES=1000000000
DB_PROJECT_USAGE_PERCENT=0
DB_CAPACITY_WARN_PERCENT=50
DB_CAPACITY_URGENT_PERCENT=70
DB_CAPACITY_RESTRICT_PERCENT=80
DB_CAPACITY_SAMPLE_SECONDS=300
DB_MAINTENANCE_SECONDS=86400
# Set a retention value to 0 to disable that group.
DB_LOGIN_RETENTION_DAYS=30
DB_ADMIN_LOGIN_RETENTION_DAYS=90
